# AuthenAI Environment Configuration Example

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEBUG=True

# MongoDB Configuration (Optional - in-memory fallback active if unreachable)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=authenai_db

# Security & Session
SECRET_KEY=authenai-super-secure-ephemeral-key-2026
SESSION_EXPIRY_SECONDS=1800
MAX_UPLOAD_SIZE_MB=15

# Risk Engine Configurable Weights (Must sum to 1.0)
WEIGHT_DOCUMENT=0.25
WEIGHT_FACE=0.25
WEIGHT_VIDEO=0.20
WEIGHT_VOICE=0.15
WEIGHT_LIVENESS=0.15

# Risk Tier Thresholds
THRESHOLD_LOW_RISK=30.0
THRESHOLD_MEDIUM_RISK=60.0
